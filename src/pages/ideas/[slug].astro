---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

// 想法页四件套（spec §3）：①问题与方案 ②demo iframe ③更新日志 ④评论区占位
export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  return ideas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const statusLabel = { seed: '萌芽', growing: '在验证', shipped: '已做成' } as const;
// hasDemo = 文件存在性探测（design-spec §⑦-1）：status 只管胶囊文案，不再推断存在性
const hasDemo = fs.existsSync(path.join(process.cwd(), 'public/demos', entry.id, 'index.html'));

// 300 字断言（design-spec §③）：body 去 markdown 标记后按字符计，>300 构建/dev 期报错阻断
const plain = (entry.body ?? '')
  .replace(/```[\s\S]*?```/g, '') // 代码围栏整块剥
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1') // 链接/图片：留锚文字剥标记
  .replace(/[#*_`>]/g, '') // 标题/强调/行内代码/引用标记
  .replace(/^\s*[-+]\s+/gm, ''); // 列表标记
const charCount = Array.from(plain.replace(/\s/g, '')).length; // Array.from 防 surrogate 拆半
if (charCount > 300) {
  throw new Error(
    `[300 字断言] 「${entry.data.title}」问题与方案 ${charCount} 字，超 300 字上限——精简到 300 字内或拆分`
  );
}
---

<Layout title={`${entry.data.title} · 想法站`}>
  <article class="idea">
    <header>
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <span class={`status status-${entry.data.status}`}>{statusLabel[entry.data.status]}</span>
        <span class="muted">创建 {entry.data.created} · 更新 {entry.data.updated}</span>
        {entry.data.tags.length > 0 && (
          <span class="muted">{entry.data.tags.map((t) => `#${t}`).join(' ')}</span>
        )}
      </div>
    </header>

    <section class="block">
      <h2>问题与方案</h2>
      <div class="prose">
        <Content />
      </div>
    </section>

    <section class="block">
      {hasDemo ? (
        <div class="demo-head">
          <h2>Demo</h2>
          <a class="demo-open" href={`/demos/${entry.id}/`} target="_blank">新窗口打开 ↗</a>
        </div>
      ) : (
        <h2>Demo</h2>
      )}
      {hasDemo ? (
        <iframe
          src={`/demos/${entry.id}/`}
          title={`${entry.data.title} 的可交互 demo`}
          loading="lazy"
        ></iframe>
      ) : (
        <div class="placeholder">
          尚无 demo（萌芽阶段）。demo 生成后，这里会变成页内可直接玩的可交互区域。
        </div>
      )}
    </section>

    <section class="block">
      <h2>更新日志</h2>
      {entry.data.changelog.length > 0 ? (
        <ul class="changelog">
          {entry.data.changelog.map((item) => (
            <li>
              <time>{item.date}</time>
              <span>{item.note}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">暂无更新记录。</p>
      )}
    </section>

    <section class="block">
      <h2>反响</h2>
      <!-- 评论区上线挂载点：发布阶段在此接入 giscus（spec §6——本地一律不挂） -->
      <div class="placeholder">评论区尚未上线（本地阶段不挂）。</div>
    </section>
  </article>
</Layout>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }

  .block {
    margin-top: 32px;
  }

  .prose {
    font-size: 0.95rem;
  }

  .prose :global(p) {
    margin: 0 0 12px;
  }

  /* 直链檐口（design-spec ②+④T3）：浅色带缓冲暗色 demo 突兀上沿，h2 左、直链右 */
  .demo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    margin-bottom: 12px; /* 接替 h2 基线下边距，块间距节奏不变 */
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .demo-head h2 {
    margin: 0;
  }

  .demo-open {
    color: var(--muted);
    font-size: 0.85rem;
  }

  iframe {
    width: 100%;
    height: 600px; /* 定高，spec §8 开放点：首版定高，2026-09-23 实机适配 E1 demo（520 裁切上调） */
    border: 1px solid var(--border);
    border-radius: 0 0 var(--radius) var(--radius);
    margin-top: -1px; /* 与上方檐口边框融合成一只画框 */
    background: var(--bg-soft);
  }

  .placeholder {
    padding: 20px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.9rem;
    background: var(--bg-soft);
  }

  .changelog {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }

  .changelog li {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--bg-soft);
  }

  .changelog time {
    color: var(--muted);
    white-space: nowrap;
  }

  /* 移动端单断点（design-spec ④T4）：③600 定高在竖屏压过整屏，80vh 兜底 */
  @media (max-width: 639px) {
    iframe {
      height: min(600px, 80vh);
    }
  }
</style>
