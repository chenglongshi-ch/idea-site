---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

// 想法页四件套（spec §3）：①问题与方案 ②demo iframe ③更新日志 ④评论区占位
export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  return ideas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const statusLabel = { seed: '萌芽', growing: '在验证', shipped: '已做成' } as const;
const hasDemo = entry.data.status !== 'seed';
---

<Layout title={`${entry.data.title} · 想法站`}>
  <article class="idea">
    <header>
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <span class={`status status-${entry.data.status}`}>{statusLabel[entry.data.status]}</span>
        <span class="muted">创建 {entry.data.created} · 更新 {entry.data.updated}</span>
      </div>
    </header>

    <section class="block">
      <h2>问题与方案</h2>
      <div class="prose">
        <Content />
      </div>
    </section>

    <section class="block">
      <h2>Demo</h2>
      {hasDemo ? (
        <iframe
          src={`/demos/${entry.id}/`}
          title={`${entry.data.title} 的可交互 demo`}
          loading="lazy"
        ></iframe>
      ) : (
        <div class="placeholder">
          尚无 demo（萌芽阶段）。demo 生成后，这里会变成页内可直接玩的可交互区域。
        </div>
      )}
    </section>

    <section class="block">
      <h2>更新日志</h2>
      {entry.data.changelog.length > 0 ? (
        <ul class="changelog">
          {entry.data.changelog.map((item) => (
            <li>
              <time>{item.date}</time>
              <span>{item.note}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">暂无记录。</p>
      )}
    </section>

    <section class="block">
      <h2>反响</h2>
      <!-- 评论区上线挂载点：发布阶段在此接入 giscus（spec §6——本地一律不挂） -->
      <div class="placeholder">评论区尚未上线（本地阶段不挂）。</div>
    </section>
  </article>
</Layout>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }

  .block {
    margin-top: 32px;
  }

  .prose {
    font-size: 0.95rem;
  }

  .prose :global(p) {
    margin: 0 0 12px;
  }

  iframe {
    width: 100%;
    height: 600px; /* 定高，spec §8 开放点：首版定高，2026-09-23 实机适配 E1 demo（520 裁切上调） */
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-soft);
  }

  .placeholder {
    padding: 20px;
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.9rem;
    background: var(--bg-soft);
  }

  .changelog {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }

  .changelog li {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--bg-soft);
  }

  .changelog time {
    color: var(--muted);
    white-space: nowrap;
  }
</style>
